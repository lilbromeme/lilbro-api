# DRACO OS — environment variables
# Copy to .env for local dev (web/.env.local for Vite-prefixed vars) and to
# your hosting/Supabase project's secret manager for deployed environments.
# NEVER commit a real .env file. NEVER put service-role keys or webhook
# secrets in a VITE_-prefixed variable — those are bundled into the
# browser build and are effectively public.

# ── Supabase (frontend-safe) ─────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Supabase (server-side only — Edge Functions / CI, never VITE_-prefixed)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Blockchain (set once the launch chain is decided) ────────────────
DRACO_NETWORK=PLACEHOLDER
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_EXPLORER_URL=
DRACO_CONTRACT_ADDRESS=
DRACO_FUND_WALLET=PLACEHOLDER

# Fee allocation percentages — must sum to <= 100 and match the deployed
# contract exactly. Leave unset until confirmed; the fee tracker treats an
# unset allocation as "unknown" rather than assuming an even split.
DRACO_FEE_FUND_PCT=
DRACO_FEE_OPS_PCT=
DRACO_FEE_COMMUNITY_PCT=

# ── Notifications ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ── Donation provider (server-side only) ──────────────────────────────
DONATION_PROVIDER_WEBHOOK_SECRET=
DONATION_PROVIDER_API_KEY=

# ── Frontend demo mode ─────────────────────────────────────────────────
# When true, /fund and /impact render clearly-labeled demo data instead of
# querying Supabase. Must be unset/false in production.
VITE_DEMO_MODE=false
